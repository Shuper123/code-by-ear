{
  "name": "code-by-ear",
  "private": true,
  "version": "0.1.0",
  "description": "Hands-free SQL and Python practice by ear. Installable web app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy_runtimes.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "python3 scripts/build_drills.py && python3 scripts/validate_drills.py",
    "check": "npm run validate && npm test",
    "deploy": "bash scripts/deploy_pages.sh",
    "smoke": "python3 scripts/browser_smoke.py",
    "datasets": "python3 scripts/generate_datasets.py"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-window": "7.4.1"
  }
}
